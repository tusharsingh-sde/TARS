# Backend configuration (read via TARS_ prefix)
# Fill in your Gemini API key before running Gemini Live features
TARS_GEMINI_API_KEY=
TARS_GEMINI_MODEL=gemini-3.8-live
TARS_DATABASE_URL=sqlite:///./tars.db
TARS_OUTLET_MATCH_THRESHOLD=0.85
TARS_SKU_MATCH_THRESHOLD=0.80

# Frontend configuration
# Note: Frontend variables (VITE_*) are baked into static assets at build time.
VITE_API_URL=http://localhost:8000
